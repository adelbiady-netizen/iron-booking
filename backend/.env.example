DATABASE_URL="postgresql://postgres:password@localhost:5432/iron_booking"
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# ATLAS POS integration master switch. Leave unset/false to fully disconnect
# Iron Booking from ATLAS (no outbound events, no inbound endpoints). Set to
# "true" only to reconnect. See src/modules/pos/flag.ts.
ATLAS_SYNC_ENABLED=false
